# VAULT xizmati uchun (127.0.0.1:8500). Bu fayl FAQAT Vault jarayoniga beriladi.
# Chegara xizmati (app/) bu qiymatlarning HECHQAYSISINI ko'rmasligi kerak.
# .env* fayllari git'ga qo'shilmasin. Generatsiya:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# 1-manba: KEK ning bir qismi. Yetkazish kanali: deploy/CI sir menejeri.
VAULT_ENV_SECRET=

# Parolga qo'shimcha maxfiy qiymat (pepper) - bazada saqlanmaydi
PASSWORD_PEPPER=

# Chegara xizmati bilan umumiy HMAC kaliti (.env.border'dagi bilan bir xil)
INTERNAL_SIGNING_KEY=

# 3-manba (admin passphrase) UCHUN env'da qiymat SAQLANMAYDI. Variantlar:
#   * production (tavsiya): hech narsa yozmang - Vault ishga tushganda terminalda so'raydi
#   * avtomatlashtirish:    ADMIN_PASSPHRASE_FILE=/run/secrets/vault_passphrase  (ruxsat 0600)
#   * FAQAT development:    ALLOW_ENV_PASSPHRASE=1 va ADMIN_PASSPHRASE=...
# ADMIN_PASSPHRASE_FILE=

# 4-manba: Shamir bo'laklari joylari (os.pathsep bilan ajratilgan, kamida 3 tasi ulangan bo'lsin).
# Bo'laklar secrets/ ICHIDA bo'lmasligi va turli joyda (USB/server/admin) turishi kerak.
# SHAMIR_SHARE_PATHS=/mnt/usb1/s:/mnt/usb2/s:/srv/admin2/s

# Ixtiyoriy
# VAULT_SECRETS_DIR=/var/lib/muallim/secrets
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
INTEGRITY_CHECK_INTERVAL_SECONDS=30
REFRESH_GRACE_SECONDS=10
ARGON_CONCURRENCY=4
