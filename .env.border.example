# CHEGARA xizmati uchun (0.0.0.0:8000). Bu faylda Vault sirlari YO'Q - ataylab.
# JWT imzolash kaliti, pepper, passphrase, KEK manbalari bu jarayonga berilmaydi.

# Vault bilan umumiy HMAC kaliti (.env.vault'dagi bilan bir xil)
INTERNAL_SIGNING_KEY=

VAULT_URL=http://127.0.0.1:8500
ALLOWED_ORIGINS=http://localhost:3000,https://muallim.uz
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=8
NODE_ENV=development

# Reverse proxy (nginx/Cloudflare...) ortida bo'lsangiz - uning IP/CIDR'i. Aks holda BO'SH qoldiring.
# TRUSTED_PROXIES=10.0.0.0/8
# DISTINCT_EMAIL_FAILS_THRESHOLD=10
